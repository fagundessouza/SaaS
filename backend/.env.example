# Copie para .env e ajuste se necessario. Valores default batem com ops/docker/docker-compose.yml

# Usada pela API e pelo worker em runtime — papel SEM privilegio de superusuario, para que RLS
# seja de fato aplicado (ver ops/docker/initdb/01-app-role.sql e ADR-0002). NUNCA aponte isto
# para o usuario de bootstrap do Postgres (superusuario sempre ignora RLS, mesmo com FORCE).
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime_dev_password@localhost:5432/licitacoes

# Usada apenas por `alembic` para rodar migrations (DDL) — precisa de privilegio de dono/criador
# de tabela, propositalmente diferente da conexao de runtime.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://licitacoes:licitacoes@localhost:5432/licitacoes

REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=licitacoes
STORAGE_SECRET_KEY=licitacoes123
STORAGE_BUCKET=licitacoes-dev

LOG_LEVEL=INFO
ENVIRONMENT=local

# Segredo de assinatura dos access tokens (JWT, HS256). NUNCA usar este valor fora de dev local.
JWT_SECRET_KEY=dev-only-change-me-1c9b6f0e6b3a4e9c9a8f7d6e5c4b3a2f

CNPJ_LOOKUP_BASE_URL=https://brasilapi.com.br/api/cnpj/v1

# Document Intelligence (Fase 4) — ver backend/README.md para como instalar o Tesseract e
# baixar os arquivos de idioma. Em Linux/Mac com tesseract no PATH, TESSERACT_CMD pode ficar
# como "tesseract"; no Windows, aponte para o caminho completo do executavel.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=.tessdata
OCR_LANGUAGE=por

# Knowledge / RAG (Fase 5)
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Opportunity Engine (Fase 7). O limiar semantico foi calibrado contra editais reais do PNCP
# (ver docs/phase-reports/FASE_7_REPORT.md): 0.55 equilibra precisao e recall, 0.50 gera muito
# falso positivo em ramos de vocabulario amplo (ex.: TI), 0.65 derruba o recall. Ajuste por
# ambiente/ramo e esperado — nao ha um valor universalmente correto.
OPPORTUNITY_SEMANTIC_MATCH_THRESHOLD=0.55
OPPORTUNITY_MATCHING_LOOKBACK_HOURS=72

# Notification Engine (Fase 10). Deixe em branco para usar os canais "console" (loga a
# notificacao em vez de enviar de verdade — ver backend/README.md) ate haver um provedor real
# configurado neste ambiente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notificacoes@licitacoes.local

# Web Push (VAPID) — gere seu proprio par de chaves, nao ha conta de terceiro envolvida:
# uv run python -c "from py_vapid import Vapid02; v = Vapid02(); v.generate_keys(); print(v.private_key_bytes()); print(v.public_key_bytes())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contato@licitacoes.local

# Assistente (Fase 9). Provider plugavel (ver ADR-0003 e ai_platform/llm/provider.py):
# "anthropic" (API externa) ou "openai_compatible" (cobre a propria OpenAI E qualquer servidor
# self-hosted que fale o mesmo protocolo — Ollama, vLLM, LM Studio etc., troque so
# LLM_BASE_URL/LLM_MODEL_NAME para apontar para o que estiver rodando, de um modelo de poucos
# bilhoes de parametros local ate 128B+ contratado numa nuvem depois — sem mudar codigo).
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MAX_TOKENS=1024
