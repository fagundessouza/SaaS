# Copie para .env.local e ajuste se necessario.

# URL do backend FastAPI (ver backend/README.md) — nunca prefixado com NEXT_PUBLIC_: so codigo
# server-side (Server Components, Route Handlers, ver src/lib/api.ts) fala com o backend, o
# navegador nunca chama esta URL diretamente (evita expor o token de acesso e a necessidade de
# CORS no backend).
BACKEND_URL=http://localhost:8000
